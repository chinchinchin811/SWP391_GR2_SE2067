<%@page import="java.util.List,model.*"%><%@page contentType="text/html" pageEncoding="UTF-8"%>
<%TrainingClass c=(TrainingClass)request.getAttribute("trainingClass");List<SmartCandidate> xs=(List<SmartCandidate>)request.getAttribute("candidates");%>
<jsp:include page="/views/common/header.jsp"/><jsp:include page="/views/common/sidebar.jsp"/>
<main class="main-content"><div class="content-body materials-page"><section class="viewer-header"><div><span class="eyebrow">SMART MATCH</span><h1>Gán nhân sự thông minh</h1><p><%=c.getClassName()%> · Hệ thống ưu tiên nhân sự mới, vừa đổi vai trò/thăng cấp và đúng cơ cấu lớp.</p></div><a class="btn" href="<%=request.getContextPath()%>/materials?action=classList">← Danh sách lớp</a></section><div class="card"><div class="card-body"><form method="post" action="<%=request.getContextPath()%>/materials"><input type="hidden" name="action" value="enrollSubmit"><input type="hidden" name="classId" value="<%=c.getClassId()%>"><div class="form-actions" style="margin-top:0"><button type="button" class="btn" onclick="document.querySelectorAll('.smart').forEach(x=>x.checked=true)">Chọn tất cả gợi ý</button><button class="btn btn-primary">Ghi danh đã chọn</button></div><table class="data-table"><thead><tr><th></th><th>Nhân sự</th><th>Phòng ban / Vị trí</th><th>Điểm phù hợp</th><th>Lý do</th></tr></thead><tbody><%for(SmartCandidate x:xs){%><tr><td><input class="smart" type="checkbox" name="userIds" value="<%=x.getUserId()%>"></td><td><b><%=x.getFullName()%></b><br><small><%=x.getEmail()%></small></td><td><%=x.getDepartmentName()%> / <%=x.getPositionName()%> / <%=x.getLevelName()%></td><td><span class="badge"><%=x.getMatchScore()>=85?"🟢 Rất khuyến nghị":x.getMatchScore()>=60?"🔵 Phù hợp":"Cân nhắc"%> — <%=x.getMatchScore()%></span></td><td><%=x.getMatchReason()%></td></tr><%}%></tbody></table></form></div></div></div></main><jsp:include page="/views/common/footer.jsp"/>
