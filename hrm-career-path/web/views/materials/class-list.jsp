<%@page import="java.util.List,model.*"%><%@page contentType="text/html" pageEncoding="UTF-8"%><%List<TrainingClass> cs=(List<TrainingClass>)request.getAttribute("classes");User me=(User)session.getAttribute("currentUser");%><jsp:include page="/views/common/sidebar.jsp"/><main class="main-content"><jsp:include page="/views/common/header.jsp"/><div class="content-body"><div class="card"><div class="card-header"><h2>Quản lý lớp đào tạo</h2><%if(me.getRoleId()<=3){%><a class="btn btn-primary" href="<%=request.getContextPath()%>/materials?action=classCreate">Mở lớp mới</a><%}%></div><div class="card-body"><table class="data-table"><tr><th>Mã lớp</th><th>Tên lớp</th><th>Mentor</th><th>Thời gian</th><th>Học viên</th><th></th></tr><%for(TrainingClass c:cs){%><tr><td><%=c.getClassCode()%></td><td><%=c.getClassName()%><br><span class="badge"><%=c.getStatus()%></span></td><td><%=c.getMentorName()%></td><td><%=c.getStartDate()%></td><td><%=c.getEnrollmentCount()%></td><td><a class="btn btn-sm" href="<%=request.getContextPath()%>/materials?action=classDetail&id=<%=c.getClassId()%>">Chi tiết</a> <%if(me.getRoleId()<=3){%><a class="btn btn-sm" href="<%=request.getContextPath()%>/materials?action=classAssign&id=<%=c.getClassId()%>">Gán nhân sự</a><%}%></td></tr><%}%></table></div></div></div></main><jsp:include page="/views/common/footer.jsp"/>
