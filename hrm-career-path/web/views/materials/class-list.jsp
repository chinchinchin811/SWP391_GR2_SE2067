<%@page import="java.util.List,model.*"%><%@page contentType="text/html" pageEncoding="UTF-8"%>
<%List<TrainingClass> cs=(List<TrainingClass>)request.getAttribute("classes");User me=(User)session.getAttribute("currentUser");%>
<jsp:include page="/views/common/header.jsp"/><jsp:include page="/views/common/sidebar.jsp"/>
<main class="main-content"><div class="content-body materials-page"><section class="viewer-header"><div><span class="eyebrow">QUẢN LÝ ĐÀO TẠO</span><h1>Lớp đào tạo</h1><p>Theo dõi chương trình, mentor và số lượng học viên của từng lớp.</p></div><%if(me.getRoleId()<=3){%><a class="btn btn-primary" href="<%=request.getContextPath()%>/materials?action=classCreate">+ Mở lớp mới</a><%}%></section><div class="card"><div class="card-body"><table class="data-table"><thead><tr><th>Mã lớp</th><th>Tên lớp</th><th>Mentor</th><th>Thời gian</th><th>Học viên</th><th>Thao tác</th></tr></thead><tbody><%for(TrainingClass c:cs){%><tr><td><b><%=c.getClassCode()%></b></td><td><%=c.getClassName()%><br><span class="badge"><%=c.getStatus()%></span></td><td><%=c.getMentorName()==null?"Chưa phân công":c.getMentorName()%></td><td><%=c.getStartDate()%></td><td><%=c.getEnrollmentCount()%></td><td><a class="btn btn-sm" href="<%=request.getContextPath()%>/materials?action=classDetail&id=<%=c.getClassId()%>">Chi tiết</a> <%if(me.getRoleId()<=3){%><a class="btn btn-sm" href="<%=request.getContextPath()%>/materials?action=classAssign&id=<%=c.getClassId()%>">Gán nhân sự</a><%}%></td></tr><%}%></tbody></table></div></div></div></main><jsp:include page="/views/common/footer.jsp"/>
