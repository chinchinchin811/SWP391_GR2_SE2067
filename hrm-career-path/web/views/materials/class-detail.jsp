<%@page import="java.util.List,model.*"%><%@page contentType="text/html" pageEncoding="UTF-8"%>
<%TrainingClass c=(TrainingClass)request.getAttribute("trainingClass");List<ClassEnrollment> es=(List<ClassEnrollment>)request.getAttribute("enrollments");User me=(User)session.getAttribute("currentUser");boolean manage=me.getRoleId()<=3;%>
<jsp:include page="/views/common/header.jsp"/><jsp:include page="/views/common/sidebar.jsp"/>
<main class="main-content"><div class="content-body materials-page"><section class="viewer-header"><div><span class="eyebrow">LỚP ĐÀO TẠO · <%=c.getStatus()%></span><h1><%=c.getClassName()%></h1><p><b><%=c.getClassCode()%></b> · Mentor: <%=c.getMentorName()==null?"Chưa phân công":c.getMentorName()%></p></div><div><a class="btn" href="<%=request.getContextPath()%>/materials?action=classList">← Danh sách lớp</a> <%if(manage){%><a class="btn btn-primary" href="<%=request.getContextPath()%>/materials?action=classAssign&id=<%=c.getClassId()%>">+ Thêm học viên</a><%}%></div></section><%if(session.getAttribute("successMessage")!=null){%><div class="alert alert-success"><%=session.getAttribute("successMessage")%></div><%session.removeAttribute("successMessage");}%><div class="card"><div class="card-body"><h2>Học liệu theo lộ trình</h2><ol><%for(LearningMaterial m:c.getMaterials()){%><li><a href="<%=request.getContextPath()%>/materials?action=view&id=<%=m.getMaterialId()%>"><b><%=m.getTitle()%></b> · <%=m.getMaterialType()%></a></li><%}%></ol></div></div><div class="card"><div class="card-header"><h2>Danh sách học viên (<%=es.size()%>)</h2></div><div class="card-body"><table class="data-table"><thead><tr><th>Học viên</th><th>Loại ghi danh</th><th>Tiến độ</th><th>Trạng thái</th><%if(manage){%><th>Thao tác</th><%}%></tr></thead><tbody><%if(es.isEmpty()){%><tr><td colspan="<%=manage?"5":"4"%>">Chưa có học viên. <%if(manage){%><a href="<%=request.getContextPath()%>/materials?action=classAssign&id=<%=c.getClassId()%>">Gán nhân sự ngay</a><%}%></td></tr><%}for(ClassEnrollment e:es){%><tr><td><b><%=e.getUserName()%></b><br><small><%=e.getAssignedReason()==null?"":e.getAssignedReason()%></small></td><td><%=e.getEnrollmentType()%></td><td><%=e.getProgressPercent()%>%</td><td><%=e.getStatus()%></td><%if(manage){%><td><form method="post" action="<%=request.getContextPath()%>/materials" style="display:inline"><input type="hidden" name="action" value="updateEnrollment"><input type="hidden" name="classId" value="<%=c.getClassId()%>"><input type="hidden" name="enrollmentId" value="<%=e.getEnrollmentId()%>"><input class="form-control" style="width:65px;display:inline" type="number" min="0" max="100" name="progressPercent" value="<%=e.getProgressPercent()%>"><select class="form-control" style="width:115px;display:inline" name="status"><option <%= "ENROLLED".equals(e.getStatus())?"selected":""%>>ENROLLED</option><option <%= "IN_PROGRESS".equals(e.getStatus())?"selected":""%>>IN_PROGRESS</option><option <%= "PASSED".equals(e.getStatus())?"selected":""%>>PASSED</option><option <%= "FAILED".equals(e.getStatus())?"selected":""%>>FAILED</option></select><button class="btn btn-sm">Lưu</button></form><form method="post" action="<%=request.getContextPath()%>/materials" style="display:inline" onsubmit="return confirm('Xóa học viên khỏi lớp?')"><input type="hidden" name="action" value="deleteEnrollment"><input type="hidden" name="classId" value="<%=c.getClassId()%>"><input type="hidden" name="enrollmentId" value="<%=e.getEnrollmentId()%>"><button class="btn btn-sm btn-danger">Xóa</button></form></td><%}%></tr><%}%></tbody></table></div></div></div></main><jsp:include page="/views/common/footer.jsp"/>
