<%@page import="model.*"%><%@page contentType="text/html" pageEncoding="UTF-8"%><%TrainingClass c=(TrainingClass)request.getAttribute("trainingClass");%><jsp:include page="/views/common/sidebar.jsp"/><main class="main-content"><jsp:include page="/views/common/header.jsp"/><div class="content-body"><div class="card"><div class="card-header"><h2><%=c.getClassName()%></h2><span class="badge"><%=c.getStatus()%></span></div><div class="card-body"><p><b>Mã lớp:</b> <%=c.getClassCode()%> &nbsp; <b>Mentor:</b> <%=c.getMentorName()%></p><p><%=c.getDescription()%></p><h3>Học liệu theo lộ trình</h3><ol><%for(LearningMaterial m:c.getMaterials()){%><li><a href="<%=request.getContextPath()%>/materials?action=view&id=<%=m.getMaterialId()%>"><b><%=m.getTitle()%></b> (<%=m.getMaterialType()%>)</a></li><%}%></ol></div></div></div></main><jsp:include page="/views/common/footer.jsp"/>
