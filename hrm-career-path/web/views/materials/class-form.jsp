<%@page import="java.util.List,model.*"%>
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<% List<LearningMaterial> ms=(List<LearningMaterial>)request.getAttribute("materials"); List<Department> ds=(List<Department>)request.getAttribute("departments"); List<Position> ps=(List<Position>)request.getAttribute("positions"); List<JobLevel> ls=(List<JobLevel>)request.getAttribute("levels"); List<User> mentors=(List<User>)request.getAttribute("mentors"); %>
<jsp:include page="/views/common/header.jsp"/><jsp:include page="/views/common/sidebar.jsp"/>
<main class="main-content"><div class="content-body materials-page"><section class="viewer-header"><div><span class="eyebrow">QUẢN LÝ ĐÀO TẠO</span><h1>Mở lớp đào tạo</h1><p>Thiết lập đối tượng, mentor và lộ trình học liệu cho lớp mới.</p></div><a class="btn" href="<%=request.getContextPath()%>/materials?action=classList">← Danh sách lớp</a></section><div class="card"><div class="card-body"><form method="post" action="<%=request.getContextPath()%>/materials"><input type="hidden" name="action" value="saveClass"><div class="form-row"><div class="form-group"><label>Mã lớp</label><input required class="form-control" name="classCode" placeholder="VD: DEV-FRESHER-2026"></div><div class="form-group"><label>Tên lớp</label><input required class="form-control" name="className"></div></div><div class="form-group"><label>Mô tả</label><textarea class="form-control" name="description"></textarea></div><div class="form-row"><div class="form-group"><label>Phòng ban mục tiêu</label><select class="form-control" name="departmentId"><option value="">Tất cả phòng ban</option><%for(Department d:ds){%><option value="<%=d.getDepartmentId()%>"><%=d.getDepartmentName()%></option><%}%></select></div><div class="form-group"><label>Vị trí mục tiêu</label><select class="form-control" name="positionId"><option value="">Tất cả vị trí</option><%for(Position p:ps){%><option value="<%=p.getPositionId()%>"><%=p.getPositionName()%></option><%}%></select></div><div class="form-group"><label>Cấp bậc mục tiêu</label><select class="form-control" name="levelId"><option value="">Tất cả cấp bậc</option><%for(JobLevel l:ls){%><option value="<%=l.getLevelId()%>"><%=l.getLevelName()%></option><%}%></select></div></div><div class="form-row"><div class="form-group"><label>Mentor phụ trách</label><select class="form-control" name="mentorId"><option value="">Chưa phân công</option><%for(User u:mentors){%><option value="<%=u.getUserId()%>"><%=u.getFullName()%></option><%}%></select></div><div class="form-group"><label>Ngày bắt đầu</label><input required class="form-control" type="date" name="startDate"></div><div class="form-group"><label>Ngày kết thúc</label><input class="form-control" type="date" name="endDate"></div></div><div class="form-group"><label>Học liệu của lớp</label><div class="class-chip-list"><%for(LearningMaterial m:ms){%><label class="class-chip"><input type="checkbox" name="materialIds" value="<%=m.getMaterialId()%>"><b><%=m.getTitle()%></b><span><%=m.getMaterialType()%> · <%=m.getDurationMinutes()%> phút</span></label><%}%></div></div><input type="hidden" name="status" value="OPEN"><div class="form-actions"><button class="btn btn-primary">Mở lớp</button><a class="btn" href="<%=request.getContextPath()%>/materials?action=classList">Hủy</a></div></form></div></div></div></main><jsp:include page="/views/common/footer.jsp"/>
