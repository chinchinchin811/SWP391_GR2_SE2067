<%@page import="java.util.List,model.*"%><%@page contentType="text/html" pageEncoding="UTF-8"%>
<%LearningMaterial m=(LearningMaterial)request.getAttribute("material");List<Department> ds=(List<Department>)request.getAttribute("departments");%>
<jsp:include page="/views/common/header.jsp"/><jsp:include page="/views/common/sidebar.jsp"/><main class="main-content"><div class="content-body materials-page"><div class="card"><div class="card-header"><h2><%=m.getMaterialId()>0?"Cập nhật":"Thêm"%> học liệu</h2></div><div class="card-body"><form method="post" enctype="multipart/form-data" action="<%=request.getContextPath()%>/materials"><input type="hidden" name="action" value="saveMaterial"><input type="hidden" name="id" value="<%=m.getMaterialId()%>"><div class="form-row"><div class="form-group"><label>Tiêu đề</label><input required class="form-control" name="title" value="<%=m.getTitle()==null?"":m.getTitle()%>"></div><div class="form-group"><label>Loại</label><select class="form-control" name="materialType"><option <%= "PDF".equals(m.getMaterialType())?"selected":""%>>PDF</option><option <%= "SLIDE".equals(m.getMaterialType())?"selected":""%>>SLIDE</option><option <%= "VIDEO".equals(m.getMaterialType())?"selected":""%>>VIDEO</option></select></div></div><div class="form-group"><label>Mô tả</label><textarea class="form-control" name="description"><%=m.getDescription()==null?"":m.getDescription()%></textarea></div><div class="form-row"><div class="form-group"><label>Phạm vi</label><select class="form-control" name="scopeType"><option>CULTURE</option><option <%= "DEPARTMENT".equals(m.getScopeType())?"selected":""%>>DEPARTMENT</option></select></div><div class="form-group"><label>Phòng ban</label><select class="form-control" name="departmentId"><option value="">Không áp dụng</option><%for(Department d:ds){%><option value="<%=d.getDepartmentId()%>"><%=d.getDepartmentName()%></option><%}%></select></div><div class="form-group"><label>Thời lượng (phút)</label><input class="form-control" type="number" min="1" name="durationMinutes" value="<%=m.getDurationMinutes()%>"></div></div><div class="form-row"><div class="form-group"><label>Tải tệp PDF / video lên</label><input class="form-control" type="file" name="materialFile" accept=".pdf,.mp4,.webm,.ppt,.pptx"></div><div class="form-group"><label>Hoặc liên kết xem trực tuyến</label><input class="form-control" name="videoUrl" placeholder="YouTube, Google Slides hoặc URL MP4" value="<%=m.getVideoUrl()==null?"":m.getVideoUrl()%>"></div></div><label><input type="checkbox" name="status" <%=m.isStatus()?"checked":""%>> Công bố</label><div class="form-actions"><button class="btn btn-primary">Lưu học liệu</button><a class="btn" href="<%=request.getContextPath()%>/materials">Hủy</a></div></form></div></div></div></main><jsp:include page="/views/common/footer.jsp"/>
